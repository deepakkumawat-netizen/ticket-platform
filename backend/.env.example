# Copy to .env and fill in for local dev (matches docker-compose.yml defaults).
DATABASE_URL="postgresql://ticketplatform:ticketplatform@localhost:5432/ticketplatform?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=3000

# Comma-separated allowlist for CORS. In production the frontend is served
# from this same process/origin, so this mostly matters for local dev (Vite
# on :5173, the default below) or any standalone frontend deploy.
CORS_ORIGIN="http://localhost:5173"

# Comma-separated allowlist for public EMPLOYEE self-signup
# (/auth/staff/signup) — closes the "sign up again with a personal email
# under a different name" loophole that email-uniqueness alone can't.
SIGNUP_ALLOWED_EMAIL_DOMAINS="codevidhya.com"

# File attachments — local disk for v1 (see storage.interface.ts).
UPLOADS_DIR="./uploads"

# Email for notifications (backend/src/notifications/mailer.service.ts).
# Preferred: RESEND_API_KEY — Render's free plan blocks outbound SMTP
# entirely (ports 25/465/587), but Resend is a plain HTTPS API so it isn't
# affected. Free key at resend.com/api-keys, no card needed. Until you
# verify your own domain there, it can only deliver to the email you signed
# up with — verify your real domain to email everyone else.
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# SMTP fallback — only used if RESEND_API_KEY is unset. Useful for a
# non-Render deploy, or a paid Render plan (which lifts the SMTP block).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="tickets@example.com"

# Email-to-ticket (backend/src/intake) — set up a receiving address in the
# Resend dashboard's Receiving tab (a managed <id>.resend.app subdomain
# needs no DNS at all), then add an "email.received" webhook pointed at
# POST /api/intake/webhooks/inbound-email and paste ITS signing secret
# (starts with "whsec_") here. Leaving this unset doesn't break anything
# else — that one endpoint just refuses every request with 503 until it's
# configured (unlike every other optional integration here, there's no safe
# "skip verification" default for an inbound webhook).
RESEND_INBOUND_WEBHOOK_SECRET=""

# AI features (backend/src/ai) — triage suggestion, draft-reply, dashboard
# insights. Get a key from https://aistudio.google.com/apikey — without it,
# those specific endpoints 400 with a clear message; nothing else breaks.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# Optional fallback AI provider (see gemini.service.ts / groq.service.ts) —
# used only when Gemini fails and this is set. Free tier is far more
# generous than Gemini's 5-requests/minute cap. Get a key at
# console.groq.com/keys. Leaving this unset is safe.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Invisible bot-check (Google reCAPTCHA v3) on staff/portal login+signup.
# Register a site at https://www.google.com/recaptcha/admin/create (type:
# v3; add both your real domain and localhost), then paste the Secret Key
# here — the matching Site Key goes in frontend/.env as
# VITE_RECAPTCHA_SITE_KEY (see that file's example). Leaving this blank is
# safe: RecaptchaService just skips verification instead of blocking login.
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"
