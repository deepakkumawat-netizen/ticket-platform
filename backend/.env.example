# Copy to .env and fill in for local dev (matches docker-compose.yml defaults).
DATABASE_URL="postgresql://ticketplatform:ticketplatform@localhost:5432/ticketplatform?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=3000

# File attachments — local disk for v1 (see storage.interface.ts).
UPLOADS_DIR="./uploads"

# SMTP relay for notifications/password resets. Fill in before testing Phase 0
# notifications end-to-end.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="tickets@example.com"
